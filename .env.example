# All variables are optional; defaults are defined in src/config.ts.

# Where the catalogue and geometry files are served from (default: <base>/data).
# VITE_DATA_BASE_URL=https://example.org/conservation-api

# MapLibre style URL for the basemap (default: OpenFreeMap Positron, free and keyless).
# VITE_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
